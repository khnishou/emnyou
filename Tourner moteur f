void tournerMoteur(float d)
{
  if (d > 45 || d <= 2) 
  {
    roulerPrecis(0);
    chercherMain();
    return;
  }
  
  if (posTete > 1600 || posTete < 1400) 
  {
    roulerPrecis(0);
    
    // ÉTAPE 1 : On bloque la valeur actuelle tout de suite
    int lectureBrute = posTete; 
    delay(100); // Petit temps mort pour stabilisation mécanique

    // ÉTAPE 2 : On confirme que la main est toujours là
    float d_conf = distanceCm();
    if (d_conf > 0 && d_conf < 50) 
    {
      // ÉTAPE 3 : Calcul précis
      // Si 2000 = Gauche et 1000 = Droite, alors (pos - 1500) est correct.
      // Si c'est l'inverse, il faut mettre : (1500 - lectureBrute)
      int angleAxe = (lectureBrute - 1500) * 90 / 500; 

      Serial.print("Position Tete: "); Serial.print(lectureBrute);
      Serial.print(" -> Angle calcule: "); Serial.println(angleAxe);

      tournerSurLuiPrecis(angleAxe);
      
      // ÉTAPE 4 : Reset immédiat pour éviter que la boucle loop() ne réutilise l'ancienne valeur
      posTete = 1500; 
      pulseServo(headPin, 1500);
      delay(300);
    }
  }
  else 
  {
    // Mode suivi face
    if (d > 20) roulerPrecis(1);
    else if (d < 12) roulerPrecis(-1);
    else roulerPrecis(0);
  }
}

  }
}
