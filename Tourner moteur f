void tournerMoteur(float d)
{
  // 1. SI AUCUNE DÉTECTION : Chercher
  if (d > 45 || d <= 2) 
  {
    roulerPrecis(0);
    chercherMain();
    return; // On sort pour ne pas exécuter la suite
  }
  
  // 2. SI DÉTECTION LATÉRALE (Le robot doit pivoter)
  if (posTete > 1650 || posTete < 1350) 
  {
    roulerPrecis(0);
    int angleCalculé = (posTete - 1500) * 90 / 500; 

    // On exécute la rotation
    tournerSurLuiPrecis(angleCalculé);
    
    // --- FORCE LE REDRESSEMENT ICI ---
    posTete = 1500; 
    pulseServo(headPin, 1500); 
    delay(200); // Temps pour que le servo physique revienne au centre
  }
  // 3. MODE SUIVI DE FACE (Redressement automatique)
  else 
  {
    // On force la tête au centre dès qu'on est dans la zone "face"
    posTete = 1500;
    pulseServo(headPin, 1500);

    if (d > 20) {
      roulerPrecis(1);
    } else if (d < 12) {
      roulerPrecis(-1);
    } else {
      roulerPrecis(0);
    }
  }
}


  }
}
