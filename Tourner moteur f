void tournerMoteur(float d)
{
  // 1. Si la main est perdue (plus de 40 cm ou 0)
  if (d > 40 || d == 0) 
  {
    roulerPrecis(0); // On stoppe les roues
    chercherMain();  // La tête balaie de gauche à droite
  }
  // 2. Si la main est trouvée, mais que la tête est tournée sur le côté
  else if (posTete > 1600 || posTete < 1400) 
  {
    int angle = (posTete - 1500) * 90 / 500; // On calcule l'angle
    
    tournerSurLuiPrecis(angle); // Le robot pivote sur lui-même
    
    posTete = 1500;
    pulseServo(headPin, posTete); // On remet la tête droite
  }
  // 3. Le robot est bien en face (tête centrée)
  else 
  {
    posTete = 1500;
    pulseServo(headPin, 1500); // On maintient la tête droite

    // On gère l'approche et le recul
    if (d > 17) {
      roulerPrecis(1);  
    } else if (d < 13) {
      roulerPrecis(-1); 
    } else {
      roulerPrecis(0);  
    }
  }
}
