void tournerMoteur(float d)
{
  // 1. CAS : MAIN PERDUE OU TROP PROCHE (ERREUR CAPTEUR)
  // On s'arrête et on balaie l'horizon avec la tête
  if (d > 40 || d <= 2) 
  {
    roulerPrecis(0);
    chercherMain();
  }
  
  // 2. CAS : MAIN DÉTECTÉE SUR LES CÔTÉS
  // Si la tête est tournée à plus de 150 µs du centre (1500)
  else if (posTete > 1650 || posTete < 1350) 
  {
    roulerPrecis(0); // On stoppe les roues pour stabiliser la mesure
    
    // TON IDÉE : Petit délai pour laisser la mécanique du servo se stabiliser
    // et éviter l'erreur de lecture au moment de l'inversion de rotation
    delay(150); 
    
    // On confirme la présence de la main avec une deuxième lecture
    float d_conf = distanceCm();
    
    if (d_conf > 0 && d_conf < 45) 
    {
      // Calcul de l'angle réel (Conversion microsecondes -> degrés)
      int angle = (posTete - 1500) * 90 / 500; 

      // Sécurité : on limite la rotation pour ne pas perdre la main de vue
      if (angle > 60) angle = 60;
      if (angle < -60) angle = -60;

      // On pivote le corps du robot
      tournerSurLuiPrecis(angle);
      
      // Après avoir pivoté, on remet la tête bien droite au centre
      posTete = 1500;
      pulseServo(headPin, posTete);
      
      // Pause pour laisser le capteur "digérer" la secousse du mouvement
      delay(250); 
    }
  }
  
  // 3. CAS : MAIN BIEN EN FACE (TÊTE CENTRÉE)
  // On ajuste la distance pour suivre la main
  else 
  {
    posTete = 1500; // On force la variable au centre
    pulseServo(headPin, 1500); // On maintient la tête droite

    if (d > 18) {
      roulerPrecis(1);  // Avancer
    } else if (d < 12) {
      roulerPrecis(-1); // Reculer
    } else {
      roulerPrecis(0);  // Zone de confort (12cm à 18cm)
    }
  }
}
