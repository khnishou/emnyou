int left10 = 10;
int right11 = 11;

int pingPin = 7;
// MODIFICATION 2 : Suppression de float v (plus besoin pour le nouveau calcul)

int headPin = 12;
int posTete = 1500;
// MODIFICATION 1 : Vitesse de la tête réduite à 15 (au lieu de 50) pour laisser le temps au capteur de voir la main
int sensTete = 15; 

volatile int count_r = 0;
volatile int count_l = 0;

const float distParImpulsion = 0.325;

void roue_r()
{
  count_r++;
}

void roue_l()
{
  count_l++;
}

void setup()
{
  pinMode(pingPin, OUTPUT);
  pinMode(left10, OUTPUT);
  pinMode(right11, OUTPUT);
  pinMode(headPin, OUTPUT);
  Serial.begin(9600);

  attachInterrupt(digitalPinToInterrupt(2), roue_r, CHANGE);
  attachInterrupt(digitalPinToInterrupt(3), roue_l, CHANGE);

  randomSeed(analogRead(A0));
}

void loop()
{
  tournerMoteur(distanceCm());
}

void pulseServo(int servoPin, int pulseLg)
{
  digitalWrite(servoPin, HIGH);
  delayMicroseconds(pulseLg);
  digitalWrite(servoPin, LOW);
}

void roulerPrecis(float direc)
{
  if (!direc)
  {
    pulseServo(left10, 1500);
    pulseServo(right11, 1500);
    delay(20);
    return ;
  }
  pulseServo(left10, (direc > 0) ? 1700 : 1300);
  pulseServo(right11, (direc > 0) ? 1300 : 1700);
  delay(20);
}

void tournerSurLuiPrecis(int angle)
 {
   count_r = 0;
   count_l = 0;

  int cible = (abs(angle) * 33.24) / (360 * distParImpulsion);

  int varL = (angle > 0) ? 1700 : 1300;
  int varR = (angle > 0) ? 1700 : 1300;

  while (count_l < cible && count_r < cible) {
    if (count_l < cible)
      pulseServo(left10, varL);

    if (count_r < cible)
      pulseServo(right11, varR);

    delay(20);
  }
}

float microsecondsToCentimeters(float microseconds) {
  return microseconds / 58;
}

// MODIFICATION 2 : Code du capteur nettoyé pour être plus rapide
float distanceCm()
{
  pinMode(pingPin, OUTPUT);
  digitalWrite(pingPin, LOW);
  delayMicroseconds(2);
  digitalWrite(pingPin, HIGH);
  delayMicroseconds(5);
  digitalWrite(pingPin, LOW);
  
  pinMode(pingPin, INPUT);
  float duration = pulseIn(pingPin, HIGH);

  return microsecondsToCentimeters(duration); 
} 

void chercherMain(){
  posTete = posTete + sensTete;

  if(posTete >= 2000 || posTete <= 1000){
    sensTete = -sensTete;
  }
  pulseServo(headPin, posTete);
}

void tournerMoteur(float d)
{
  // 1. Si la main est perdue (plus de 35 cm ou 0)
  if (d > 35 || d == 0) 
  {
    roulerPrecis(0); // On stoppe les roues
    chercherMain();  // La tête balaie de gauche à droite
  }
  // 2. Si la main est trouvée, mais que la tête est tournée sur le côté
  else if (posTete > 1600 || posTete < 1400) 
  {
    int angle = (posTete - 1500) * 90 / 500; // On calcule l'angle
    
    tournerSurLuiPrecis(angle); // Le robot pivote sur lui-même
    
    posTete = 1500; // Mise à jour de la variable
    
    // MODIFICATION 3 : Boucle d'attente pour laisser la tête se recentrer mécaniquement
    for(int i = 0; i < 15; i++) {
      roulerPrecis(0);              // Maintient les roues à l'arrêt
      pulseServo(headPin, posTete); // Envoie l'ordre de centrage à la tête
      delay(20);                    // Respecte la fréquence du signal
    }
  }
  // 3. Le robot est bien en face (tête centrée)
  else 
  {
    posTete = 1500;
    pulseServo(headPin, 1500); // On maintient la tête droite

    // On gère l'approche et le recul
    if (d > 17 && d < 35) {
      roulerPrecis(1);  
    } else if (d < 13) {
      roulerPrecis(-1); 
    } else {
      roulerPrecis(0);  
    }
  }
}
